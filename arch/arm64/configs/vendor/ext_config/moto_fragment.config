#
# Motorola vendor config fragment for malmo (SM6375/blair)
# Applied via build.config.moto during defconfig stage
#

# --- Device tree ---
CONFIG_MMI_DEVICE_DTBS=y
CONFIG_MALMO_DTB=y
CONFIG_PINCTRL_MALMO=y

# --- Reboot / debug ---
CONFIG_MOTO_LEGACY_REBOOT_REASON_SUPPORT=y

# --- Scheduler ---
CONFIG_SCHED_MOTO_UNFAIR=m

# --- UFS storage ---
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_UFSHID_POC=y
CONFIG_SCSI_SKHID=y
CONFIG_MICRON_UFSHID=y

# --- Thermal ---
CONFIG_BATT_THERMAL_100K_MALMO=y

# --- I2C ---
CONFIG_I2C_MSM_GENI_GPIO_RECOVERY=y

# --- Display (SDE/DRM) ---
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_SDE=y
CONFIG_SYNC_FILE=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DSI_PARSER=y
CONFIG_DRM_MSM_REGISTER_LOGGING=y
CONFIG_QCOM_MDSS_PLL=y
CONFIG_DISPLAY_BUILD=m
CONFIG_MSM_SDE_ROTATOR=y
CONFIG_MSM_SDE_ROTATOR_EVTLOG_DEBUG=y

# --- Camera (Spectra) ---
CONFIG_SPECTRA_ISP=y
CONFIG_SPECTRA_OPE=y
CONFIG_SPECTRA_TFE=y
CONFIG_SPECTRA_SENSOR=y

# --- SecureMSM / crypto ---
CONFIG_QSEECOM=y
CONFIG_QCOM_SMCINVOKE=y
CONFIG_QTI_TZ_LOG=y
CONFIG_CRYPTO_DEV_QCEDEV=y
CONFIG_CRYPTO_DEV_QCRYPTO=y
CONFIG_HW_RANDOM_MSM_LEGACY=y
CONFIG_HDCP_QSEECOM=y

# --- Audio (Qualcomm) ---
CONFIG_SND_SOC_QDSP6V2=y
CONFIG_SND_SOC_MSM_QDSP6V2_INTF=y
CONFIG_MSM_ADSP_LOADER=y
CONFIG_MSM_QDSP6_PDR=y
CONFIG_MSM_QDSP6_NOTIFIER=y
CONFIG_SPF_CORE=y
CONFIG_AUDIO_PRM=y
CONFIG_AUDIO_PKT_ION=y
CONFIG_MSM_QDSP6_GPR_RPMSG=y
CONFIG_AUDIO_PKT=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_WCD_CTRL=y
CONFIG_SND_EVENT=y
CONFIG_PINCTRL_WCD=y
CONFIG_PINCTRL_LPI=y
CONFIG_SND_SOC_WCD9XXX_V2=y
CONFIG_WCD9XXX_CODEC_CORE=y
CONFIG_SND_SOC_BOLERO=y
CONFIG_VA_MACRO=y
CONFIG_TX_MACRO=y
CONFIG_RX_MACRO=y
CONFIG_WSA_MACRO=y
CONFIG_SND_SOC_WSA881X=y
CONFIG_SND_SOC_WCD937X=y
CONFIG_SND_SOC_WCD937X_SLAVE=y
CONFIG_SND_SOC_WCD938X=y
CONFIG_SND_SOC_WCD938X_SLAVE=y
CONFIG_SND_SOC_FS1815=y
CONFIG_SND_SOC_PINEAPPLE=y

# --- NFC ---
CONFIG_NXP_NFC_I2C=y

# --- IPA / RMNET ---
CONFIG_RMNET=y
CONFIG_IPA=y
CONFIG_IPA_RMNET=y
